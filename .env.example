# Variables consumed by docker-compose.yml itself — distinct from
# backend/.env and dashboard/.env.local, which each service still needs of
# its own. Copy to .env before `docker compose up`.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=voiceagent

# The public origin real visitors/browsers reach this deployment at — used
# to build the widget's CDN URL, Dodo Checkout/Portal redirect URLs, and
# the dashboard's own API base URL, all of which must be routed through
# nginx rather than pointing at a Docker-internal service name.
# Local testing: http://localhost. Real deployment: https://yourdomain.com.
PUBLIC_ORIGIN=http://localhost
