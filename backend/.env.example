# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

APP_ENV=local
DEBUG=true

# Async driver for the app. Alembic derives its own sync URL from this.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceagent

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-this-is-not-secure

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated. Origins allowed to call the *dashboard* API.
# The public widget API uses per-agent origin allowlists instead (Step 3).
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used from Step 4. Get a free key (no card required) at
# https://aistudio.google.com/apikey — Gemini's free tier is generous enough
# for testing with real users. Leave blank to run everything else without it.
GEMINI_API_KEY=

# Voice (Step 7) pipeline: Groq for STT + the voice-reply LLM (free, no
# card — console.groq.com), Fish Audio for TTS (free tier confirmed via its
# s2.1-pro-free model — fish.audio/app/developers; its other, paid voices
# 402 on a zero-balance account, so this specific model matters).
GROQ_API_KEY=
FISH_AUDIO_API_KEY=
# Optional Fish Audio reference_id (voice clone/preset) — leave unset to
# use the account's default voice.
# VOICE_DEFAULT_VOICE=

# Firecrawl (website-crawl ingestion) — free tier, firecrawl.dev.
FIRECRAWL_API_KEY=

# Used from Step 9 (billing). Dodo Payments, not Stripe — Stripe does not
# onboard new India-registered accounts. Test-mode keys/product IDs from
# https://app.dodopayments.com (Developer -> API Keys / Webhooks; Products
# for the price IDs — one recurring Product per paid tier).
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
DODO_PRODUCT_ID_STARTER=
DODO_PRODUCT_ID_PRO=
DODO_PRODUCT_ID_ENTERPRISE=

# Where the dashboard runs — used to build Dodo Checkout/Portal redirect URLs.
DASHBOARD_BASE_URL=http://localhost:3000

# Used from Step 10 (deployment). Leave blank for local dev/tests — the
# public-widget rate limiter falls back to an in-memory store. Set this once
# running more than one worker/instance (e.g. the docker-compose stack, which
# sets it to redis://redis:6379/0) so all workers share one rate-limit view.
REDIS_URL=

# Only set to true when this process actually sits behind a reverse proxy
# (e.g. the bundled nginx) that itself sets/overwrites X-Forwarded-For.
# Leave false for local dev or any directly-exposed deployment — otherwise a
# client can spoof its own rate-limit/audit IP by sending the header itself.
TRUST_PROXY_HEADERS=false
