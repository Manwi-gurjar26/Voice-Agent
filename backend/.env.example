# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

APP_ENV=local
DEBUG=true

# Async driver for the app. Alembic derives its own sync URL from this.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voiceagent

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-this-is-not-secure

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated. Origins allowed to call the *dashboard* API.
# The public widget API uses per-agent origin allowlists instead (Step 3).
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used from Step 4. Leave blank for now.
ANTHROPIC_API_KEY=

# Used from Step 7 (voice). Only required for tenants with an agent that has
# voice_enabled=true — leave blank otherwise.
OPENAI_API_KEY=

# Used from Step 9 (billing). Test-mode keys from https://dashboard.stripe.com
# (Developers -> API keys / Webhooks). Price IDs come from Products you create
# there — one recurring Price per paid tier.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Where the dashboard runs — used to build Stripe Checkout/Portal redirect URLs.
DASHBOARD_BASE_URL=http://localhost:3000
