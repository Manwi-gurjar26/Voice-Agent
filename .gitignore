# Secrets
.env
.env.*
!.env.example
# Vite convention: .env.development / .env.production hold no secrets and
# are meant to be committed; only .env.*.local (still matched above) does.
!.env.development
!.env.production

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
backend/.voice_models/
# Built by backend/Dockerfile's widget-build stage; also written locally
# when serving the widget from the backend during tunnel testing.
backend/static/

# Node
node_modules/
.next/
dist/
build/
*.tsbuildinfo
vite.config.*.timestamp-*.mjs
vitest.config.*.timestamp-*.mjs

# Machine-specific compose overrides (port remaps for what's already
# running on this host) — never the same on two machines.
docker-compose.override.yml

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
